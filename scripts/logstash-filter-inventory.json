{
  "version": 1,
  "source": {
    "notes": "Catalog of Logstash filter plugins covered by Logit.io docs. Combines plugins bundled in Logstash with the additional filters installed in the Logit Logstash Docker image."
  },
  "plugins": [
    { "plugin": "age", "package": "logstash-filter-age", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Calculates event age in seconds from the event timestamp." },
    { "plugin": "aggregate", "package": "logstash-filter-aggregate", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Aggregates information across events that belong to the same task." },
    { "plugin": "alter", "package": "logstash-filter-alter", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Performs field alterations that are not handled by mutate." },
    { "plugin": "bytes", "package": "logstash-filter-bytes", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses storage-size strings such as 123 MB into bytes." },
    { "plugin": "cidr", "package": "logstash-filter-cidr", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Checks IP addresses against one or more network ranges." },
    { "plugin": "cipher", "package": "logstash-filter-cipher", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Encrypts or decrypts field values in events." },
    { "plugin": "clone", "package": "logstash-filter-clone", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Duplicates events so each copy can follow a separate branch." },
    { "plugin": "csv", "package": "logstash-filter-csv", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses comma-separated data into fields." },
    { "plugin": "date", "package": "logstash-filter-date", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses date/time values and sets the event timestamp." },
    { "plugin": "de_dot", "package": "logstash-filter-de_dot", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Removes dots from field names." },
    { "plugin": "dissect", "package": "logstash-filter-dissect", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Extracts structured fields from delimited text." },
    { "plugin": "dns", "package": "logstash-filter-dns", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Performs forward or reverse DNS lookups." },
    { "plugin": "drop", "package": "logstash-filter-drop", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Drops events that match conditions." },
    { "plugin": "elapsed", "package": "logstash-filter-elapsed", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Measures elapsed time between related start/end events." },
    { "plugin": "elastic_integration", "package": "logstash-filter-elastic_integration", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Applies additional processing for integration data." },
    { "plugin": "elasticsearch", "package": "logstash-filter-elasticsearch", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Enriches events with fields fetched from Elasticsearch." },
    { "plugin": "environment", "package": "logstash-filter-environment", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Copies environment variable values into event metadata fields." },
    { "plugin": "extractnumbers", "package": "logstash-filter-extractnumbers", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Extracts numeric values from text fields." },
    { "plugin": "fingerprint", "package": "logstash-filter-fingerprint", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Builds stable hashes or fingerprints from selected fields." },
    { "plugin": "geoip", "package": "logstash-filter-geoip", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Enriches events with geo information derived from IPs." },
    { "plugin": "grok", "package": "logstash-filter-grok", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses unstructured strings into named fields using patterns." },
    { "plugin": "http", "package": "logstash-filter-http", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Calls HTTP APIs and enriches events with responses." },
    { "plugin": "i18n", "package": "logstash-filter-i18n", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Normalizes text by removing special characters." },
    { "plugin": "java_uuid", "package": "core plugin", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Generates a UUID for each processed event using the Java implementation." },
    { "plugin": "jdbc_streaming", "package": "logstash-integration-jdbc", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Enriches events with row lookups from JDBC data sources." },
    { "plugin": "json", "package": "logstash-filter-json", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses JSON content from source fields into event fields." },
    { "plugin": "json_encode", "package": "logstash-filter-json_encode", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Serializes field content into JSON strings." },
    { "plugin": "kv", "package": "logstash-filter-kv", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses key/value text into structured fields." },
    { "plugin": "math", "package": "logstash-filter-math", "official": false, "defaultBundled": false, "imageInstalled": true, "status": "covered", "summary": "Applies arithmetic operations to numeric fields." },
    { "plugin": "memcached", "package": "logstash-filter-memcached", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Reads or writes enrichment values from Memcached." },
    { "plugin": "metricize", "package": "logstash-filter-metricize", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Splits complex events into per-metric events." },
    { "plugin": "metrics", "package": "logstash-filter-metrics", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Aggregates metrics from event streams." },
    { "plugin": "mutate", "package": "logstash-filter-mutate", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Renames, converts, removes, and updates fields." },
    { "plugin": "prune", "package": "logstash-filter-prune", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Whitelists or blacklists fields to keep event payloads focused." },
    { "plugin": "range", "package": "logstash-filter-range", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Checks field values against numeric or length bounds." },
    { "plugin": "ruby", "package": "logstash-filter-ruby", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Executes inline Ruby code for custom transformations." },
    { "plugin": "sleep", "package": "logstash-filter-sleep", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Introduces delays while processing events." },
    { "plugin": "split", "package": "logstash-filter-split", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Splits arrays or multiline data into separate events." },
    { "plugin": "syslog_pri", "package": "logstash-filter-syslog_pri", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses syslog PRI values into severity and facility fields." },
    { "plugin": "threats_classifier", "package": "logstash-filter-threats_classifier", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Classifies attacker intent in security log events." },
    { "plugin": "throttle", "package": "logstash-filter-throttle", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Rate-limits events by key and period." },
    { "plugin": "tld", "package": "logstash-filter-tld", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Extracts top-level domain components from URLs or hostnames." },
    { "plugin": "translate", "package": "logstash-filter-translate", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Maps field values using dictionary data." },
    { "plugin": "truncate", "package": "logstash-filter-truncate", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Truncates long field values to a maximum length." },
    { "plugin": "urldecode", "package": "logstash-filter-urldecode", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Decodes URL-encoded field values." },
    { "plugin": "useragent", "package": "logstash-filter-useragent", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses user-agent strings into browser, OS, and device fields." },
    { "plugin": "uuid", "package": "logstash-filter-uuid", "official": true, "defaultBundled": true, "imageInstalled": true, "status": "covered", "summary": "Adds UUID values to events." },
    { "plugin": "wurfl_device_detection", "package": "logstash-filter-wurfl_device_detection", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Enriches events with device intelligence from WURFL." },
    { "plugin": "xml", "package": "logstash-filter-xml", "official": true, "defaultBundled": true, "imageInstalled": false, "status": "covered", "summary": "Parses XML into structured event fields." }
  ]
}
